# Prevent access to .git, .github, and config.php
RedirectMatch 401 ^/(\.git|\.github|config\.php)

# Mountaineer IT: our notes (CLAUDE.md, DEPLOYMENT.md, MIT_CHANGELOG.md, MIT_FEATURES.md, MIT_API.md) map the code - not served
RedirectMatch 404 ^/(CLAUDE|DEPLOYMENT|MIT_CHANGELOG|MIT_FEATURES|MIT_API)\.md$
# ... nor a PDF left in the top folder (e.g. a write-up of our changes) - ITFlow serves none from there
RedirectMatch 404 ^/[^/]+\.pdf$

# Security headers on every response: no type guessing, the address of a page sent only to
# ITFlow itself, and no framing by other sites (a login or guest page shown inside another
# site to trick clicks). HSTS is left to your web server, which knows whether HTTPS is for good.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

# Mountaineer IT (26.12.1.3): browsers may keep scripts, styles, fonts and images. Every script / stylesheet tag carries
# ?v=<file time> (ITFlow's staticFileUrl, our mitAsset), so a versioned one is kept a year and never re-checked - an update
# gives it a new address; the rest (fonts and images the stylesheets ask for, TinyMCE's own parts) a week. Without this the
# browser guessed from the file's date, which right after an update is minutes - phones re-checked every file on every page.
# Uploads (attachments, logos) and draw.io's own files (unversioned - an editor update must not mix old and new) are left alone.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico|map)$# && %{REQUEST_URI} !~ m#^/(uploads|mit_drawio)/#">
    Header set Cache-Control "max-age=604800"
  </If>
  <If "%{REQUEST_URI} =~ m#\.(js|css)$# && %{REQUEST_URI} !~ m#^/uploads/# && %{QUERY_STRING} =~ /(^|&)v=[0-9]+/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
