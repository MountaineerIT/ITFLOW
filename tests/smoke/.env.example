# Copy to .env (never committed) and fill in. A TEST install only - see README.md.
ITFLOW_URL=https://itflow-beta.example.com
ITFLOW_EMAIL=smoke-admin@example.com
ITFLOW_PASSWORD=
# Optional: a Technician-role login for the permission checks
ITFLOW_TECH_EMAIL=
ITFLOW_TECH_PASSWORD=
# Optional, when running on the server itself: the site's PHP error log
ITFLOW_PHP_LOG=/var/log/apache2/itflow-error.log
# Optional: the install has no DNS name - send ITFLOW_URL's host to this address
ITFLOW_HOST_IP=
# Optional: self-signed certificate on the test install
ITFLOW_IGNORE_HTTPS_ERRORS=
