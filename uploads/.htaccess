Options -ExecCGI -Indexes
php_flag engine off
RemoveHandler .php .phtml .phar .phps
RemoveType .php .phtml .phar .phps
<FilesMatch "\.(php|phtml|phar|phps|cgi|pl|sh)$">
  Require all denied
</FilesMatch>
# Mountaineer IT: a file opened straight from here is never run as a page - no type guessing, and no scripts (an HTML,
# SVG or XML file someone uploaded stays inert). Images and PDFs show as before.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "script-src 'none'; object-src 'none'; base-uri 'none'"
</IfModule>
